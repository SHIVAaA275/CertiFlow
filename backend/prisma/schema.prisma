generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CENTRE
  DISTRICT
  QUALITY
  STATE
}

enum BatchStatus {
  DRAFT
  DISTRICT_REVIEW
  QUALITY_REVIEW
  STATE_REVIEW
  RETURNED
  REJECTED
  APPROVED
}

enum ApprovalDecision {
  APPROVED
  RETURNED
  REJECTED
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

model Centre {
  id        String   @id @default(cuid())
  name      String
  district  String
  users     User[]
  batches   Batch[]
  createdAt DateTime @default(now())
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role
  centreId     String?
  centre       Centre?    @relation(fields: [centreId], references: [id])
  batches      Batch[]    @relation("CreatedBatches")
  approvals    Approval[]
  auditLogs    AuditLog[]
  createdAt    DateTime   @default(now())
}

model Batch {
  id                String      @id @default(cuid())
  title             String
  courseName        String
  centreId          String
  centre            Centre      @relation(fields: [centreId], references: [id])
  createdById       String
  createdBy         User        @relation("CreatedBatches", fields: [createdById], references: [id])
  status            BatchStatus @default(DRAFT)
  submissionVersion Int         @default(0)
  submittedAt       DateTime?
  approvedAt        DateTime?
  returnedReason    String?
  candidates        Candidate[]
  approvals         Approval[]
  auditLogs         AuditLog[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model Candidate {
  id           String       @id @default(cuid())
  batchId      String
  batch        Batch        @relation(fields: [batchId], references: [id])
  fullName     String
  email        String?
  phone        String
  enrollmentNo String
  passed       Boolean      @default(true)
  certificate  Certificate?

  @@unique([batchId, enrollmentNo])
}

model Approval {
  id                String           @id @default(cuid())
  batchId           String
  batch             Batch            @relation(fields: [batchId], references: [id])
  officerId         String
  officer           User             @relation(fields: [officerId], references: [id])
  submissionVersion Int
  decision          ApprovalDecision
  reason            String?
  createdAt         DateTime         @default(now())

  @@unique([batchId, submissionVersion, officerId])
}

model Certificate {
  id                String     @id @default(cuid())
  certificateNumber String     @unique
  candidateId       String     @unique
  candidate         Candidate  @relation(fields: [candidateId], references: [id])
  verificationToken String     @unique
  pdfPath           String?
  issuedAt          DateTime   @default(now())
  revokedAt         DateTime?
  revokedReason     String?
  deliveries        Delivery[]
}

model Delivery {
  id            String         @id @default(cuid())
  certificateId String
  certificate   Certificate    @relation(fields: [certificateId], references: [id])
  status        DeliveryStatus @default(PENDING)
  attempts      Int            @default(0)
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  batchId   String?
  batch     Batch?   @relation(fields: [batchId], references: [id])
  action    String
  details   Json?
  createdAt DateTime @default(now())
}
